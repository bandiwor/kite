fn run() {
    var parts = [];
    for i in 0..300000 {
        parts:push("item" + i);
    }
    const s = string.join(parts, ",");
    const back = string.split(s, ",");
    var n = 0;
    for p in back { n += p:len(); }
    var acc = "";
    for i in 0..20000 { acc = acc + "x"; }
    n + acc:len()
}
print(run());
