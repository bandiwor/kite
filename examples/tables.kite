// Word frequencies with a table, then sorting the result.
const text = "the quick brown fox jumps over the lazy dog the end";
const freq = {};
for word in text:split(" ") {
    freq[word] = if freq:has(word) { freq[word] + 1 } else { 1 };
}

const entries = [];
for word, count in freq { entries:push({ word, count }); }
entries:sort(|a, b| => a.count > b.count || (a.count == b.count && a.word < b.word));

for e in entries { print(string.format("{:<6} {}", e.word, e.count)); }
print("distinct words:", freq:len());
