// literals, arithmetic, precedence
const PI = 3.14;
var x = 10;
x += 10;
print(PI, x);            // expect: 3.14 20
print(1 + 2 * 3);        // expect: 7
print((1 + 2) * 3);      // expect: 9
print(2 ** 3 ** 2);      // expect: 512
print(-2 ** 2);          // expect: -4
print(10 % 3, 7 / 2);    // expect: 1 3.5
print(1 / 0, -1 / 0);    // expect: inf -inf
print(0 / 0 == 0 / 0);   // expect: false
print(5 & 3, 5 | 3, 5 ^ 3, ~5, 1 << 4, 256 >> 2);  // expect: 1 7 6 -6 16 64
print(1_000 + 0xff + 0b11);  // expect: 1258
print("a" + "b", "n=" + 5);  // expect: ab n=5
print(true && false, true || false, !true);  // expect: false true false
print(nil && 1, nil || 2, 0 && 3, "" || 4);  // expect: nil 2 3 
print(1 < 2, 2 <= 2, 3 > 4, 3 >= 3, 1 == 1, 1 != 1);  // expect: true true false true true false
print("abc" < "abd", "b" > "a", "a" == "a");  // expect: true true true
var a = 1; var b = 2;
a = b = 7;
print(a, b);   // expect: 7 7
x = 5; x -= 2; x *= 4; x /= 3; x %= 3; x **= 2;
print(x);      // expect: 1
var s = 0xF0; s &= 0x3C; s |= 1; s ^= 0xFF; s <<= 1; s >>= 2;
print(s);      // expect: 103
print(type(1), type("s"), type(nil), type(true), type([]), type(print), type(|| => 1));  // expect: number string nil bool table function function
// modulo semantics (integer fast path vs fmod)
print(7 % 3, -7 % 3, 7 % -3, -7 % -3);   // expect: 1 -1 1 -1
print(5.5 % 2, -5.5 % 2, 1e20 % 7 >= 0);   // expect: 1.5 -1.5 true
print(5 % 0 != 5 % 0, 0 % 5, -4 % 2);   // expect: true 0 -0
