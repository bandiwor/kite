const t = { a: 1, b: 2, c: 3 };
var n = 0;
for k, v in t { n += 1; if n < 20 { t["k" + n] = n; } }
print(n >= 3, len(t));

const cyc = { name: "loop" };
cyc.self = cyc;
print(cyc);

struct Bad { x }
impl Bad { fn str(self) { 42 } }
print(catch_panic(print, Bad(1)):unwrap_err().message);

const arr = [1, 2, 3];
for i, v in arr { if i == 0 { remove(arr, 0); } }
print(arr);

// deleting every key while iterating
const m = {};
for i in 0..50 { m["k" + i] = i; }
for k in keys(m) { m[k] = nil; }
print(len(m));

// arrays keep nil
const holes = [1, nil, 3];
print(len(holes), holes[0], holes[1], holes[2]);
push(holes, nil);
print(len(holes), holes);

// arrays do not grow by assignment; they are bounds-checked
const sparse = [];
print(catch_panic(|| => { sparse[5] = "x"; }));
print(catch_panic(|| => sparse[0]));
push(sparse, "a", "b");
sparse[1] = "z";
print(sparse, array.new(3, "-"));

// negative and fractional keys
const odd = {};
odd[-1] = "neg"; odd[0.5] = "half"; odd[1e300] = "big";
print(odd[-1], odd[0.5], odd[1e300], odd[2]);

// a string key and a number key never collide
const mix = { "1": "str", [1]: "num" };
print(mix["1"], mix[1]);

// chained comparisons of different types are false, not errors (==) / errors (<)
print(1 == "1", nil == 0);
print(catch_panic(|| => 1 < "a"):unwrap_err().message);
print(catch_panic(|| => nil + 1):unwrap_err().message);
print(catch_panic(|| => [] + []):unwrap_err().message);
print(catch_panic(|| => undefined_fn()):unwrap_err().message);
print(catch_panic(|| => (5)(1)):unwrap_err().message);
print(catch_panic(|| => "abc".x):unwrap_err().message);
print(catch_panic(|| => nil.x):unwrap_err().message);
print(catch_panic(|| => nil[0]):unwrap_err().message);
print(catch_panic(|| => len(5)):unwrap_err().message);
print(catch_panic(|| => push(5, 1)):unwrap_err().message);
print(catch_panic(|| => for i in 5 { }):unwrap_err().message);
print(catch_panic(|| => for i in "a".."b" { }):unwrap_err().message);

// expect: true 22
// expect: {name: "loop", self: {name: "loop", self: {name: "loop", self: {name: "loop", self: {name: "loop", self: {name: "loop", self: {name: "loop", self: {...}}}}}}}}
// expect: `str` of struct 'Bad' must return a string
// expect: [2, 3]
// expect: 0
// expect: 3 1 nil 3
// expect: 4 [1, nil, 3, nil]
// expect: Err(array index 5 is out of bounds (length 0))
// expect: Err(array index 0 is out of bounds (length 0))
// expect: ["a", "z"] ["-", "-", "-"]
// expect: neg half big nil
// expect: str num
// expect: false false
// expect: cannot compare number and string
// expect: invalid operands for '+': nil and number
// expect: invalid operands for '+': array and array
// expect: undefined variable 'undefined_fn'
// expect: cannot call a value of type number
// expect: cannot read field 'x' of string
// expect: cannot read field 'x' of nil
// expect: cannot index a value of type nil
// expect: len: cannot take the length of number
// expect: push: argument 1 must be an array, got number
// expect: cannot iterate over number
// expect: range bounds must be numbers, got string and string
