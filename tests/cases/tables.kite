const t = { name: "kite", "two words": 2, [1 + 1]: "computed", 3: "three" };
print(t.name, t["two words"], t[2], t[3]);   // expect: kite 2 computed three
t.name = "KITE";
t["x"] = 10;
t.x += 5;
print(t.name, t.x);   // expect: KITE 15
print(t.missing);   // expect: nil

// arrays are tables with keys 0..n-1
const a = [1, 2, 3];
print(a[0], a[2], a[3], len(a));   // expect: 1 3 nil 3
push(a, 4, 5);
a[5] = 6;
print(len(a), a);   // expect: 6 [1, 2, 3, 4, 5, 6]
print(pop(a), len(a));   // expect: 6 5
a[0] += 10;
print(a[0]);   // expect: 11

// keys: strings by content, numbers by value, bool, tables by identity
const k = {};
k["ab"] = 1;
k["a" + "b"] += 1;
k[1.5] = "f";
k[true] = "t";
const keytable = {};
k[keytable] = "tbl";
print(k.ab, k[1.5], k[true], k[keytable], k[{}]);   // expect: 2 f t tbl nil
k[0] = "zero"; k[-0] = "negzero";
print(k[0], len(k));   // expect: negzero 5

// nil removes, has / keys / values
k.ab = nil;
print(has(k, "ab"), has(k, 1.5));   // expect: false true
const m = { a: 1, b: 2, c: 3 };
print(keys(m), values(m));   // expect: ["a", "b", "c"] [1, 2, 3]
print(m);   // expect: {a: 1, b: 2, c: 3}
for key, val in m { write(key, val, ";"); }
print();   // expect: a1;b2;c3;
for val in m { write(val); }
print();   // expect: 123

// deleting during iteration is fine
for key in keys(m) { m[key] = nil; }
print(len(m));   // expect: 0

// insert / remove shift arrays
const arr = [1, 2, 3, 4];
insert(arr, 1, 99);
print(arr);   // expect: [1, 99, 2, 3, 4]
print(remove(arr, 0), arr);   // expect: 1 [99, 2, 3, 4]

// nested
const nested = { list: [1, { deep: "yes" }], f: |x| => x * 2 };
print(nested.list[1].deep, nested.f(21));   // expect: yes 42
print([1, "a", [2]], { x: [1] });   // expect: [1, "a", [2]] {x: [1]}
const sh = 5;
print({ sh });   // expect: {sh: 5}

// large hash and array
var big = {};
for i in 0..1000 { big[i * 7] = i; }
var cnt = 0;
for kk, vv in big { cnt += vv; }
print(len(big), cnt);   // expect: 1000 499500
for i in 0..1000 { if i % 2 == 0 { big[i * 7] = nil; } }
print(len(big));   // expect: 500

// functional helpers
print(map([1, 2, 3], |x| => x * x));   // expect: [1, 4, 9]
print(filter([1, 2, 3, 4], |x| => x % 2 == 0));   // expect: [2, 4]
print(reduce([1, 2, 3, 4], |a, b| => a + b, 0), reduce([5, 6], |a, b| => a * b));   // expect: 10 30
print(sort([3, 1, 2]), sort(["b", "a"]), sort([3, 1, 2], |a, b| => a > b));   // expect: [1, 2, 3] ["a", "b"] [3, 2, 1]
each([7, 8], |v, i| => write(i, ":", v, " "));
print();   // expect: 0:7 1:8 
