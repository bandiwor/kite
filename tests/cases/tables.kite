const t = { name: "kite", "two words": 2, [1 + 1]: "computed", 3: "three" };
print(t.name, t["two words"], t[2], t[3]);   // expect: kite 2 computed three
t.name = "KITE";
t["x"] = 10;
t.x += 5;
print(t.name, t.x);   // expect: KITE 15
print(t.missing);   // expect: nil

// arrays are not tables: they keep every value (nil too) and are bounds-checked
const a = [1, 2, 3];
print(a[0], a[2], a:len(), type(a));   // expect: 1 3 3 array
a:push(4, 5);
a:push(6);
print(a:len(), a);   // expect: 6 [1, 2, 3, 4, 5, 6]
print(a:pop(), a:len());   // expect: Some(6) 5
a[0] += 10;
print(a[0]);   // expect: 11
print(catch_panic(|| => a[5]));   // expect: Err(array index 5 is out of bounds (length 5))
print(a:get(5), a:get(4));   // expect: None Some(5)

// keys: strings by content, numbers by value, bool, tables by identity
const k = {};
k["ab"] = 1;
k["a" + "b"] += 1;
k[1.5] = "f";
k[true] = "t";
const keytable = {};
k[keytable] = "tbl";
print(k.ab, k[1.5], k[true], k[keytable], k[{}]);   // expect: 2 f t tbl nil
k[0] = "zero"; k[-0] = "negzero";
print(k[0], k:len());   // expect: negzero 5

// nil removes, has / keys / values
k.ab = nil;
print(k:has("ab"), k:has(1.5));   // expect: false true
const m = { a: 1, b: 2, c: 3 };
print(m:keys(), m:values());   // expect: ["a", "b", "c"] [1, 2, 3]
print(m);   // expect: {a: 1, b: 2, c: 3}
for key, val in m { write(key, val, ";"); }
print();   // expect: a1;b2;c3;
for val in m { write(val); }
print();   // expect: 123

// deleting during iteration is fine
for key in m:keys() { m[key] = nil; }
print(m:len());   // expect: 0

// insert / remove shift arrays
const arr = [1, 2, 3, 4];
arr:insert(1, 99);
print(arr);   // expect: [1, 99, 2, 3, 4]
print(arr:remove(0), arr);   // expect: 1 [99, 2, 3, 4]

// nested
const nested = { list: [1, { deep: "yes" }], f: |x| => x * 2 };
print(nested.list[1].deep, nested.f(21));   // expect: yes 42
print([1, "a", [2]], { x: [1] });   // expect: [1, "a", [2]] {x: [1]}
const sh = 5;
print({ sh });   // expect: {sh: 5}

// large hash and array
var big = {};
for i in 0..1000 { big[i * 7] = i; }
var cnt = 0;
for kk, vv in big { cnt += vv; }
print(big:len(), cnt);   // expect: 1000 499500
for i in 0..1000 { if i % 2 == 0 { big[i * 7] = nil; } }
print(big:len());   // expect: 500

// functional helpers
print([1, 2, 3]:map(|x| => x * x));   // expect: [1, 4, 9]
print([1, 2, 3, 4]:filter(|x| => x % 2 == 0));   // expect: [2, 4]
print([1, 2, 3, 4]:reduce(|a, b| => a + b, 0), [5, 6]:reduce(|a, b| => a * b));   // expect: 10 30
print([3, 1, 2]:sort(), ["b", "a"]:sort(), [3, 1, 2]:sort(|a, b| => a > b));   // expect: [1, 2, 3] ["a", "b"] [3, 2, 1]
[7, 8]:each(|v, i| => write(i, ":", v, " "));
print();   // expect: 0:7 1:8 

// string keys are looked up by content, whichever way the string was built (hashes are computed lazily)
const sk = {};
const half = "a";
sk["ab"] = 1;
sk[half + "b"] += 10;
sk["x" + "y"] = 2;
const long1 = string.rep("long-key-", 500);
const long2 = string.rep("long-key-", 250) + string.rep("long-key-", 250);
sk[long1] = "long";
print(sk["ab"], sk["xy"], sk[long2], sk[long1 + "!"], sk:len());   // expect: 11 2 long nil 3
sk[""] = "empty";
print(sk["" + ""], sk[half + ""] , sk:has("a"), sk:has(""));   // expect: empty nil false true
